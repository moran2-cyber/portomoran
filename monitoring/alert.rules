groups:
  - name: portomoran_alerts
    rules:

      # ── App ───────────────────────────────────────
      - alert: AppDown
        expr: up{job="nginx"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Frontend DOWN"
          description: "Frontend tidak dapat dijangkau selama lebih dari 1 menit."

      # ── API ───────────────────────────────────────
      - alert: APIDown
        expr: up{job="api"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "API DOWN"
          description: "Backend API tidak dapat dijangkau selama lebih dari 1 menit."

      - alert: APIHighErrorRate
        expr: rate(api_http_requests_total{status=~"5.."}[5m]) > 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "API error rate tinggi"
          description: "Lebih dari 1 request 5xx per detik dalam 5 menit terakhir."

      - alert: APIHighLatency
        expr: histogram_quantile(0.95, rate(api_http_request_duration_seconds_bucket[5m])) > 2
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "API latency tinggi"
          description: "95% request membutuhkan lebih dari 2 detik."

      # ── Redis ─────────────────────────────────────
      - alert: RedisDown
        expr: up{job="redis"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Redis DOWN"
          description: "Redis tidak dapat dijangkau."
