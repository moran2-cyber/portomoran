# Salin file ini: cp .env.example .env

# ── GitHub Container Registry ──────────────────────────
# Format: username/nama-repo (huruf kecil semua)
GITHUB_REPOSITORY=moran2-cyber/portomoran

# Tag image (diisi otomatis oleh CI/CD, jangan diubah manual)
IMAGE_TAG=latest

# ── Cloudflare Tunnel ──────────────────────────────────
# Didapat dari step: cloudflared tunnel token <nama-tunnel>
CLOUDFLARE_TUNNEL_TOKEN=

# ── Domain ─────────────────────────────────────────────
DOMAIN=yourdomain.com

# ── Grafana ────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=ganti_password_kuat

# ── Alertmanager (Email) ───────────────────────────────
ALERT_EMAIL=your@email.com
ALERT_EMAIL_PASSWORD=gmail_app_password
